# ========================================
# REQUIRED - Core Services
# ========================================

# Supabase (REQUIRED)
# Get these from: https://app.supabase.com → Project Settings → API
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ========================================
# BILLING - Stripe (if using subscriptions)
# ========================================

# Stripe Publishable Key
# Get from: https://dashboard.stripe.com/apikeys
# Use test key for development, live key for production
VITE_STRIPE_PUBLIC_KEY=your-stripe-publishable-key-here

# ========================================
# APP METADATA
# ========================================

# Your product name (displayed in UI)
VITE_APP_NAME=My SaaS Product

# Support email (shown in footer, contact forms)
VITE_SUPPORT_EMAIL=support@myproduct.com

# App URL (used for OAuth redirects, email links)
VITE_APP_URL=http://localhost:8080

# ========================================
# OPTIONAL - Monitoring & Analytics
# ========================================

# Sentry (Error Tracking)
# Get from: https://sentry.io → Settings → Projects → [Your Project] → Client Keys (DSN)
# VITE_SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# Google Analytics 4
# Get from: https://analytics.google.com → Admin → Data Streams → Measurement ID
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# PostHog (Product Analytics)
# Get from: https://app.posthog.com → Project Settings → API Key
# VITE_POSTHOG_KEY=your-posthog-key-here
# VITE_POSTHOG_HOST=https://app.posthog.com

# ========================================
# OPTIONAL - Feature Flags
# ========================================

# Enable/disable major features
# These can also be controlled via database (admin_feature_toggles table)
# Use these for environment-specific overrides

# Enable organization/multi-tenancy features
# VITE_ENABLE_ORGANIZATIONS=true

# Enable blog and content management
# VITE_ENABLE_BLOG=true

# Enable affiliate/referral system
# VITE_ENABLE_AFFILIATES=false

# Enable AI chat support
# VITE_ENABLE_AI_SUPPORT=true

# ========================================
# DEVELOPMENT ONLY
# ========================================

# Enable debug logging in development
# VITE_DEBUG=true

# Skip email verification in development
# VITE_SKIP_EMAIL_VERIFICATION=false

# ========================================
# NOTES
# ========================================

# 1. Copy this file to .env for local development:
#    cp .env.example .env
#
# 2. Never commit .env to git (it's in .gitignore)
#
# 3. For production, set these in your hosting platform:
#    - Vercel: Settings → Environment Variables
#    - Netlify: Site Settings → Build & Deploy → Environment
#
# 4. Always use PRODUCTION keys for production deployments!
#    - Supabase: Use production project
#    - Stripe: Use live keys (not test keys)
#
# 5. Edge function secrets are set separately in Supabase:
#    npx supabase secrets set RESEND_API_KEY=your-resend-key
#    npx supabase secrets set OPENAI_API_KEY=your-openai-key
#    npx supabase secrets set STRIPE_SECRET_KEY=your-stripe-secret
#    npx supabase secrets set STRIPE_WEBHOOK_SECRET=your-webhook-secret
