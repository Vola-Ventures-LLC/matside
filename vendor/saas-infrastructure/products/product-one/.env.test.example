# Supabase - Use your dev environment for local testing
# For CI/CD, you'll want a separate test project to avoid conflicts
VITE_SUPABASE_URL_TEST=https://xxx.supabase.co
VITE_SUPABASE_ANON_KEY_TEST=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY_TEST=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9... # Optional - only needed for DB cleanup fixtures

# Test user credentials (pre-seeded in Supabase test project)
TEST_USER_EMAIL=test-user@example.com
TEST_USER_PASSWORD=TestPassword123!
TEST_ADMIN_EMAIL=test-admin@example.com
TEST_ADMIN_PASSWORD=AdminPassword123!
TEST_OWNER_EMAIL=test-owner@example.com
TEST_OWNER_PASSWORD=OwnerPassword123!

# Stripe test mode (optional, for billing tests)
VITE_STRIPE_PUBLIC_KEY_TEST=pk_test_xxx
STRIPE_SECRET_KEY_TEST=sk_test_xxx

# Playwright
PLAYWRIGHT_BASE_URL=http://localhost:5173
