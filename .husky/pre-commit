#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Run lint-staged for code quality
pnpm exec lint-staged --config .lintstagedrc.mjs

# Check for secrets
echo "Scanning for secrets..."
FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -v '\.md$' | grep -v '^\.husky/' | grep -v '^\.semgrep/' | grep -v '^vendor/' || true)

if [ -n "$FILES" ]; then
  if echo "$FILES" | xargs grep -l "eyJ[A-Za-z0-9_-]*\.[A-Za-z0-9_-]*\.[A-Za-z0-9_-]*" 2>/dev/null; then
    echo "Potential JWT token found in staged files!"
    exit 1
  fi
  if echo "$FILES" | xargs grep -l "sk_live_[a-zA-Z0-9]*\|pk_live_[a-zA-Z0-9]*" 2>/dev/null; then
    echo "Potential Stripe key found in staged files!"
    exit 1
  fi
  if echo "$FILES" | xargs grep -l "postgres://.*:.*@" 2>/dev/null; then
    echo "Database connection string found!"
    exit 1
  fi
  if echo "$FILES" | xargs grep -l "re_[A-Za-z0-9]\{32\}" 2>/dev/null; then
    echo "Resend API key found!"
    exit 1
  fi
fi

echo "Pre-commit checks passed"
